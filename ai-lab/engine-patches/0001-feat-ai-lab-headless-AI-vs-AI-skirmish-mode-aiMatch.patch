+// GeneralsX @feature ai-lab 07/11/2026 Headless AI-vs-AI match flags, see Common/AIMatch.h.
+Int parseAIMatch(char *args[], int num)
+{
+	TheAIMatchOptions.enabled = TRUE;
+	TheWritableGlobalData->m_playIntro = FALSE;
+	TheWritableGlobalData->m_playSizzle = FALSE;
+	TheWritableGlobalData->m_shellMapOn = FALSE;
+	rts::ClientInstance::setMultiInstance(TRUE);
+	rts::ClientInstance::skipPrimaryInstance();
+	return 1;
+}
+Int parseAIMap(char *args[], int num)
+{
+	if (num > 1) { TheAIMatchOptions.map = args[1]; return 2; }
+	return 1;
+}
+Int parseAIPlayer(char *args[], int num)
+{
+	if (num > 1) { TheAIMatchOptions.players.push_back(AsciiString(args[1])); return 2; }
+	return 1;
+}
+Int parseAISeed(char *args[], int num)
+{
+	if (num > 1) { TheAIMatchOptions.seed = atoi(args[1]); return 2; }
+	return 1;
+}
+Int parseAICash(char *args[], int num)
+{
+	if (num > 1) { TheAIMatchOptions.cash = atoi(args[1]); return 2; }
+	return 1;
+}
+Int parseAIMaxMinutes(char *args[], int num)
+{
+	if (num > 1) { TheAIMatchOptions.maxMinutes = atoi(args[1]); return 2; }
+	return 1;
+}
+Int parseAIResult(char *args[], int num)
+{
+	if (num > 1) { TheAIMatchOptions.resultPath = args[1]; return 2; }
+	return 1;
+}
+
 Int parseReplay(char *args[], int num)
 {
 	if (num > 1)
@@ -1192,6 +1235,15 @@ static CommandLineParam paramsForStartup[] =
 	// You can also include wildcards. The file must be in the replay folder or in a subfolder.
 	{ "-replay", parseReplay },
 
+	// GeneralsX @feature ai-lab 07/11/2026 Headless AI-vs-AI match. Startup table, so the shell map is off before engine init (as -replay).
+	{ "-aiMatch", parseAIMatch },
+	{ "-aiMap", parseAIMap },
+	{ "-aiPlayer", parseAIPlayer },
+	{ "-aiSeed", parseAISeed },
+	{ "-aiCash", parseAICash },
+	{ "-aiMaxMinutes", parseAIMaxMinutes },
+	{ "-aiResult", parseAIResult },
+
 	// TheSuperHackers @feature helmutbuhler 23/05/2025
