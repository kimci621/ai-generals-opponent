+// GeneralsX @feature ai-lab 07/11/2026 Headless AI-vs-AI skirmish match for the AI test range.
+// Usage: -headless -aiMatch -aiMap <map> -aiPlayer <Faction>:<easy|medium|hard> (one per slot)
+//        -aiSeed <n> -aiCash <n> -aiMaxMinutes <n> -aiResult <path.json>
+// Exit codes: 0 match played out (win, draw or time limit), 2 bad arguments, 3 could not start.
+
+#pragma once
+
+#include <vector>
+
+struct AIMatchOptions
+{
+	Bool enabled = FALSE;
+	AsciiString map;
+	std::vector<AsciiString> players;   // "FactionGLA:hard"
+	Int seed = -1;
+	Int cash = 10000;
+	Int maxMinutes = 90;
+	AsciiString resultPath;
+};
+
+extern AIMatchOptions TheAIMatchOptions;
+
+namespace AIMatch
+{
+	int run();   // process exit code
+}
diff --git a/Core/GameEngine/Source/Common/AIMatch.cpp b/Core/GameEngine/Source/Common/AIMatch.cpp
new file mode 100644
index 0000000..10a5d6f
--- /dev/null
+++ b/Core/GameEngine/Source/Common/AIMatch.cpp
@@ -0,0 +1,232 @@
+/*
+**	Command & Conquer Generals Zero Hour(tm)
+**
+**	This program is free software: you can redistribute it and/or modify
+**	it under the terms of the GNU General Public License as published by
+**	the Free Software Foundation, either version 3 of the License, or
+**	(at your option) any later version.
+*/
+
+// GeneralsX @feature ai-lab 07/11/2026 Headless AI-vs-AI skirmish match, modelled on ReplaySimulation.
+
+#include "PreRTS.h"	// This must go first in EVERY cpp file in the GameEngine
+
+#include "Common/AIMatch.h"
+
+#include "Common/GlobalData.h"
+#include "Common/KindOf.h"
+#include "Common/MessageStream.h"
+#include "Common/Money.h"
+#include "Common/Player.h"
+#include "Common/PlayerList.h"
+#include "Common/PlayerTemplate.h"
+#include "Common/RandomValue.h"
+#include "GameClient/GameClient.h"
+#include "GameClient/MapUtil.h"
+#include "GameLogic/GameLogic.h"
+#include "GameLogic/Object.h"
+#include "GameLogic/VictoryConditions.h"
+#include "GameNetwork/GameInfo.h"
+
+#include <cstdio>
+#include <string>
+#include <unistd.h>
+
+AIMatchOptions TheAIMatchOptions;
+
+namespace
+{
+const Int FRAMES_2MIN = 2 * 60 * LOGICFRAMES_PER_SECOND;
+
+int fail(int code, const char *fmt, const char *arg = "")
+{
+	fprintf(stderr, "[AIMatch] error: ");
+	fprintf(stderr, fmt, arg);
+	fprintf(stderr, "\n");
+	fflush(stderr);
+	return code;
+}
+
+Int countStructures(Player *player)
+{
+	Int count = 0;
+	for (Object *obj = TheGameLogic->getFirstObject(); obj; obj = obj->getNextObject())
+	{
+		if (obj->isKindOf(KINDOF_STRUCTURE) && obj->getControllingPlayer() == player)
+			++count;
+	}
+	return count;
+}
+
+std::string jsonEscape(const char *s)
+{
+	std::string out;
+	for (; *s; ++s)
+	{
+		if (*s == '\\' || *s == '"')
+			out += '\\';
+		out += *s;
+	}
+	return out;
+}
+} // namespace
+
+int AIMatch::run()
+{
+	const AIMatchOptions &o = TheAIMatchOptions;
+	if (!TheGlobalData->m_headless)
+		return fail(2, "-aiMatch requires -headless%s");
+	if (o.map.isEmpty() || o.resultPath.isEmpty() || o.players.size() < 2 || o.players.size() > MAX_SLOTS || o.maxMinutes <= 0)
+		return fail(2, "need -aiMap, -aiResult and 2..8 -aiPlayer%s");
+
+	// Slots, as in SkirmishGameOptionsMenuInit
+	TheSkirmishGameInfo = NEW SkirmishGameInfo;
+	TheSkirmishGameInfo->init();
+	TheSkirmishGameInfo->clearSlotList();
+	TheSkirmishGameInfo->reset();
+	TheSkirmishGameInfo->setLocalIP(TheSkirmishGameInfo->getSlot(0)->getIP());
+	TheSkirmishGameInfo->enterGame();
+
+	std::vector<AsciiString> factions, difficulties;
+	for (size_t i = 0; i < o.players.size(); ++i)
+	{
+		const char *spec = o.players[i].str();
+		const char *colon = strchr(spec, ':');
+		if (!colon)
+			return fail(2, "bad -aiPlayer '%s', expected Faction:difficulty", spec);
+		AsciiString faction;
+		faction.set(spec, (Int)(colon - spec));
+		AsciiString difficulty(colon + 1);
+		SlotState state;
+		if (difficulty == "easy") state = SLOT_EASY_AI;
+		else if (difficulty == "medium") state = SLOT_MED_AI;
+		else if (difficulty == "hard") state = SLOT_BRUTAL_AI;
+		else return fail(2, "bad difficulty in '%s'", spec);
+		Int templateNum = ThePlayerTemplateStore->getTemplateNumByName(faction);
+		if (templateNum < 0)
+			return fail(3, "unknown faction '%s'", faction.str());
+
+		GameSlot *slot = TheSkirmishGameInfo->getSlot((Int)i);
+		slot->setState(state);
+		slot->setPlayerTemplate(templateNum);
+		slot->setColor(-1);
+		slot->setStartPos(-1);
+		slot->setTeamNumber(-1);
+		factions.push_back(faction);
+		difficulties.push_back(difficulty);
+	}
+	for (Int i = (Int)o.players.size(); i < MAX_SLOTS; ++i)
+		TheSkirmishGameInfo->getSlot(i)->setState(SLOT_CLOSED);
+
+	const MapMetaData *md = TheMapCache->findMap(o.map);
+	if (!md)
+		return fail(3, "map not found '%s'", o.map.str());
+	if (!md->m_isMultiplayer)
+		return fail(3, "not a multiplayer map '%s'", o.map.str());
+	if (md->m_numPlayers < (Int)o.players.size())
+		return fail(3, "map has fewer start positions than players '%s'", o.map.str());
+
+	TheSkirmishGameInfo->setMap(o.map);
+	TheSkirmishGameInfo->setMapCRC(md->m_CRC);
+	TheSkirmishGameInfo->setMapSize(md->m_filesize);
+	Money cash;
+	cash.deposit(o.cash, FALSE, FALSE);
+	TheSkirmishGameInfo->setStartingCash(cash);
+
+	const Int seed = o.seed >= 0 ? o.seed : (Int)GetTickCount();
+	TheWritableGlobalData->m_mapName = TheSkirmishGameInfo->getMap();
+	TheSkirmishGameInfo->startGame(0);
+	TheSkirmishGameInfo->setSeed(seed);
+	InitRandom(seed);
+
+	// The headless loop does not process TheMessageStream, so post straight to TheCommandList (as RecorderClass::playbackFile does)
+	GameMessage *msg = newInstance(GameMessage)(GameMessage::MSG_NEW_GAME);
+	msg->appendIntegerArgument(GAME_SKIRMISH);
+	msg->appendIntegerArgument(DIFFICULTY_NORMAL);
+	msg->appendIntegerArgument(0);
+	TheCommandList->appendMessage(msg);
+
+	const UnsignedInt maxFrame = (UnsignedInt)o.maxMinutes * 60 * LOGICFRAMES_PER_SECOND;
+	const size_t n = o.players.size();
+	std::vector<Int> atStart(n, -1), at2min(n, -1);
+	Bool started = FALSE;
+	const char *outcome = nullptr;
+	for (Int idle = 0; !outcome; )
+	{
+		TheGameClient->updateHeadless();
+		TheGameLogic->UPDATE();
+		// Nobody reads TheMessageStream here (selection and CRC messages for the local observer); drop them
+		while (GameMessage *m = TheMessageStream->getFirstMessage())
+			deleteInstance(m);
+
+		const UnsignedInt frame = TheGameLogic->getFrame();
+		if (!started)
+		{
+			if (TheGameLogic->getGameMode() == GAME_SKIRMISH && frame >= 1)
+			{
+				started = TRUE;
+				for (size_t i = 0; i < n; ++i)
+					atStart[i] = countStructures(ThePlayerList->getPlayerFromSlotIndex((Int)i));
+			}
+			else if (++idle > 1000)
+				return fail(3, "game did not start%s");
+			continue;
+		}
+		if (at2min[0] < 0 && frame >= (UnsignedInt)FRAMES_2MIN)
+		{
+			for (size_t i = 0; i < n; ++i)
+				at2min[i] = countStructures(ThePlayerList->getPlayerFromSlotIndex((Int)i));
+		}
+		if (TheVictoryConditions->getEndFrame() != 0)
+			outcome = "win";
+		else if (frame >= maxFrame)
+			outcome = "timeout";
+		if (frame % (10 * 60 * LOGICFRAMES_PER_SECOND) == 0)
+		{
+			printf("[AIMatch] game time %u min\n", frame / (60 * LOGICFRAMES_PER_SECOND));
+			fflush(stdout);
+		}
+	}
+
+	std::vector<Bool> won(n, FALSE);
+	Int winners = 0;
+	if (strcmp(outcome, "win") == 0)
+	{
+		for (size_t i = 0; i < n; ++i)
+		{
+			won[i] = TheVictoryConditions->hasAchievedVictory(ThePlayerList->getPlayerFromSlotIndex((Int)i));
+			winners += won[i] ? 1 : 0;
+		}
+		if (winners == 0)
+			outcome = "draw";
+	}
+
+	const UnsignedInt endFrame = TheGameLogic->getFrame();
+	const UnsignedInt crc = TheGameLogic->getCRC(CRC_RECALC);
+	std::string tmpPath = std::string(o.resultPath.str()) + ".tmp";
+	FILE *f = fopen(tmpPath.c_str(), "w");
+	if (!f)
+		return fail(3, "cannot write '%s'", tmpPath.c_str());
+	fprintf(f, "{\"schema\": 1, \"seed\": %d, \"map\": \"%s\", \"outcome\": \"%s\", \"end_frame\": %u, "
+		"\"game_seconds\": %.1f, \"final_crc\": %u, \"players\": [",
+		seed, jsonEscape(o.map.str()).c_str(), outcome, endFrame,
+		(double)endFrame / LOGICFRAMES_PER_SECOND, crc);
+	for (size_t i = 0; i < n; ++i)
+	{
+		char at2[16];
+		if (at2min[i] < 0) strcpy(at2, "null"); else snprintf(at2, sizeof(at2), "%d", at2min[i]);
+		fprintf(f, "%s{\"slot\": %d, \"faction\": \"%s\", \"difficulty\": \"%s\", \"won\": %s, "
+			"\"structures_at_start\": %d, \"structures_at_2min\": %s}",
+			i ? ", " : "", (int)i, factions[i].str(), difficulties[i].str(), won[i] ? "true" : "false", atStart[i], at2);
+	}
+	fprintf(f, "]}\n");
+	fflush(f);
+	fclose(f);
+	rename(tmpPath.c_str(), o.resultPath.str());
+
+	printf("[AIMatch] %s at frame %u\n", outcome, endFrame);
+	fflush(stdout);
+	fflush(stderr);
+	// Nobody has tested tearing down a loaded recorded skirmish here; a crash on exit would turn a played match into "crash"
+	_exit(0);
+}
