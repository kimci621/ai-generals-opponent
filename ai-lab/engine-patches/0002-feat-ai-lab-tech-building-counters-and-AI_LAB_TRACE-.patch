+Bool isDerrick(const Object *obj)
+{
+	return obj->getTemplate()->getName() == "TechOilDerrick";
+}
+
+// Read-only, does not affect simulation or CRC. player == nullptr counts every owner
+void countTech(Player *player, Int &derricks, Int &tech)
+{
+	derricks = tech = 0;
+	for (Object *obj = TheGameLogic->getFirstObject(); obj; obj = obj->getNextObject())
+	{
+		if (!obj->isKindOf(KINDOF_TECH_BUILDING) || (player && obj->getControllingPlayer() != player))
+			continue;
+		++tech;
+		if (isDerrick(obj))
+			++derricks;
+	}
+}
+
+std::string jsonIntOrNull(Int v)
+{
+	return v < 0 ? std::string("null") : std::to_string(v);
+}
+
 std::string jsonEscape(const char *s)
 {
 	std::string out;
@@ -71,6 +106,77 @@ std::string jsonEscape(const char *s)
 }
 } // namespace
 
+Bool AIMatch::traceWanted(const char *name)
+{
+	static const char *pattern = getenv("AI_LAB_TRACE");
+	return pattern && *pattern && name && strstr(name, pattern) != nullptr;
+}
+
+void AIMatch::trace(const char *fmt, ...)
+{
+	fprintf(stderr, "[TRACE f=%u] ", TheGameLogic ? TheGameLogic->getFrame() : 0);
+	va_list args;
+	va_start(args, fmt);
+	vfprintf(stderr, fmt, args);
+	va_end(args);
+	fprintf(stderr, "\n");
+}
+
+namespace
+{
+// Trace: tech building positions at start, then every change of owner
+void traceTechOwners(std::map<ObjectID, Player *> &owners)
+{
+	for (Object *obj = TheGameLogic->getFirstObject(); obj; obj = obj->getNextObject())
+	{
+		if (!obj->isKindOf(KINDOF_TECH_BUILDING))
+			continue;
+		Player *owner = obj->getControllingPlayer();
+		std::map<ObjectID, Player *>::iterator it = owners.find(obj->getID());
+		if (it != owners.end() && it->second == owner)
+			continue;
+		const Coord3D *pos = obj->getPosition();
+		AIMatch::trace("tech %s #%d (%.0f, %.0f) owner %s", obj->getTemplate()->getName().str(), (int)obj->getID(),
+			pos->x, pos->y, owner ? TheNameKeyGenerator->keyToName(owner->getPlayerNameKey()).str() : "-");
+		owners[obj->getID()] = owner;
+	}
+}
+} // namespace
+
+namespace
+{
+// Trace: members of teams whose name matches AI_LAB_TRACE, and the capture-building upgrade per player
+void traceTeamsAndUpgrades(size_t n, std::vector<Int> &hadCapture)
+{
+	static const UpgradeTemplate *capture = TheUpgradeCenter->findUpgrade("Upgrade_InfantryCaptureBuilding");
+	for (size_t i = 0; i < n; ++i)
+	{
+		Player *p = ThePlayerList->getPlayerFromSlotIndex((Int)i);
+		Int has = capture && p->hasUpgradeComplete(capture) ? 1 : 0;
+		if (has != hadCapture[i])
+		{
+			AIMatch::trace("player %d capture upgrade = %d", (int)i, (int)has);
+			hadCapture[i] = has;
+		}
+	}
+	for (Object *obj = TheGameLogic->getFirstObject(); obj; obj = obj->getNextObject())
+	{
+		Team *team = obj->getTeam();
+		if (!team || obj->isKindOf(KINDOF_STRUCTURE) || !AIMatch::traceWanted(team->getName().str()))
+			continue;
+		const Coord3D *pos = obj->getPosition();
+		BodyModuleInterface *body = obj->getBodyModule();
+		AIUpdateInterface *ai = obj->getAI();
+		Object *goal = ai ? ai->getGoalObject() : nullptr;
+		const Coord3D *gp = ai ? ai->getGoalPosition() : nullptr;
+		AIMatch::trace("unit %s #%d team '%s' (%.0f, %.0f) hp %.0f state %d src %d goal #%d (%.0f, %.0f)", obj->getTemplate()->getName().str(), (int)obj->getID(),
+			team->getName().str(), pos->x, pos->y, body ? body->getHealth() : -1.0f,
+			ai ? (int)ai->getAIStateType() : -1, ai ? (int)ai->getLastCommandSource() : -1,
+			goal ? (int)goal->getID() : -1, gp ? gp->x : 0.0f, gp ? gp->y : 0.0f);
+	}
+}
