+// GeneralsX @feature ai-lab 10/11/2026 Per-player SkirmishScripts.scb for -aiMatch: park the current skirmish
+// templates in backup and load the given file in their place. Call restoreSkirmishScripts afterwards.
+Bool SidesList::swapInSkirmishScripts(const AsciiString& path, SkirmishScriptsBackup& backup)
+{
+	for (Int i = 0; i < MAX_SKIRMISH_SIDES; ++i)
+	{
+		backup.lists[i] = m_skirmishSides[i].getScriptList();
+		m_skirmishSides[i].setScriptList(nullptr);
+	}
+	backup.teams = m_skirmishTeamrec;
+	return loadSkirmishScriptsFile(path);
+}
 
+void SidesList::restoreSkirmishScripts(SkirmishScriptsBackup& backup)
+{
+	for (Int i = 0; i < MAX_SKIRMISH_SIDES; ++i)
+	{
+		deleteInstance(m_skirmishSides[i].getScriptList());
+		m_skirmishSides[i].setScriptList(backup.lists[i]);
+		backup.lists[i] = nullptr;
 	}
+	m_skirmishTeamrec = backup.teams;
 }
 
 
