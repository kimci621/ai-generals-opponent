+AsciiString AIMatch::skirmishScriptsFor(const AsciiString &playerName)
+{
+	const std::vector<AsciiString> &scripts = TheAIMatchOptions.scripts;
+	Int slot = -1;
+	if (!TheAIMatchOptions.enabled || sscanf(playerName.str(), "player%d", &slot) != 1 || slot < 0 || slot >= (Int)scripts.size())
+		return AsciiString::TheEmptyString;
+	return scripts[slot];
+}
