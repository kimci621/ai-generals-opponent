From 4019a4b5bf6ffca1a95162d927056790a4111b05 Mon Sep 17 00:00:00 2001
From: Amir Latipov <kimciwork@gmail.com>
Date: Mon, 16 Nov 2026 10:42:14 +0300
Subject: [PATCH 6/7] feat(ai-lab): transport payload joins the transport's
 team

Units produced inside a transport (China Troop Crawler's Red Guards) were
left without a team and stood at the base forever. They now join the team
of the transport that carries them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Source/GameLogic/Object/Contain/TransportContain.cpp     | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/GeneralsMD/Code/GameEngine/Source/GameLogic/Object/Contain/TransportContain.cpp b/GeneralsMD/Code/GameEngine/Source/GameLogic/Object/Contain/TransportContain.cpp
index e52365b..e0ee1c6 100644
--- a/GeneralsMD/Code/GameEngine/Source/GameLogic/Object/Contain/TransportContain.cpp
+++ b/GeneralsMD/Code/GameEngine/Source/GameLogic/Object/Contain/TransportContain.cpp
@@ -446,7 +446,10 @@ void TransportContain::createPayload()
 		for( int i = 0; i < count; i++ )
 		{
 			//We are creating a transport that comes with a initial payload, so add it now!
-			Object* payload = TheThingFactory->newObject( payloadTemplate, object->getControllingPlayer()->getDefaultTeam() );
+			// GeneralsX @feature ai-lab 12/11/2026 The payload joins the transport's team instead of the player's
+			// default team: AI scripts only command teams, so the 8 Red Guards of each AI Troop Crawler stood idle
+			// at base for the whole game once unloaded. For a human player both teams are the default team.
+			Object* payload = TheThingFactory->newObject( payloadTemplate, object->getTeam() ? object->getTeam() : object->getControllingPlayer()->getDefaultTeam() );
 			if( contain->isValidContainerFor( payload, true ) )
 			{
 				contain->addToContain( payload );
-- 
